# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.manifest
*.spec

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs. The numbered suffixes are RotatingFileHandler's backups
# (engine.log.1, .2, ...) — *.log does not match them, so without this
# a 45MB rotated log sat untracked and one 'git add -A' from history.
*.log
*.log.[0-9]*
# gateway_watch.sh's down-state marker (runtime, not source)
logs/.gateway_down

# Local config (may contain credentials)
config.local.py
.env

# Virtual environment (project-local symlink)
env_claude

# Plugin runtime state (generated by the engine, not source)
plugins/*/state.json
plugins/*/holdings.json
plugins/_unassigned/
# Account-scoped plugin state (plugins/<name>/<account_id>/...)
plugins/*/*/state.json
plugins/*/*/holdings.json
plugins/*/*/instruments.json
plugins/*/*/alerts.jsonl

# Historical bar data (runtime cache, not source)
historical/*.db
historical/*.db-shm
historical/*.db-wal
historical/config.json

# STATE snapshot (holds live positions; travels with a filesystem image of the
# repo, never committed)
STATE.json
STATE.json.tmp

# Filled-in launch scripts. start-live.sh.example is tracked and carries the
# shape of a correct launch; the copies carry the account and operator ids,
# which name a real brokerage account and real people. Only the template
# belongs in a public repository.
start-live.sh
start-real.sh
start-paper.sh

# Migration bundles built by tools/migrate-collect.sh — they contain a STATE
# snapshot (live positions) and host configuration.
tws-migrate-*.tar.gz
